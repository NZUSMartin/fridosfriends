---
/**
 * Newsletter page: the sign-up field, and — when opened from the confirmation mail (?t=<signed token>) —
 * the confirmation step of the double opt-in. Confirming needs a button click on purpose
 * (mail scanners pre-open links; a plain page view must not subscribe anyone).
 */
import Layout from '../../../layouts/Layout.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import NewsletterSignup from '../../../components/NewsletterSignup.astro';
import { NEWSLETTER_ISSUES } from '../../../consts';

// archive: newest first; the section is only rendered once there is an issue
const issues = [...NEWSLETTER_ISSUES].sort((a, b) => b.date.localeCompare(a.date));
const when = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---
<Layout title="Newsletter" description="Sign up for the Frido's Friends newsletter and hear how the girls we support are doing." lang="en" path="/en/newsletter" spine="none">
  <section class="section">
    <div class="container container-text" data-nlpage data-nlview="signup">
      <script is:inline>(function(el){try{if(/[?&]t=[\w.-]+/.test(location.search))el.setAttribute('data-nlview','confirm');}catch(e){}})(document.currentScript.parentElement);</script>
      <Eyebrow text="Newsletter" />

      <div class="nlview" data-view="signup">
        <h1>Stay close.</h1>
        <p class="lead" style="margin-top:var(--sp-5)">We report on how the girls we support are doing.</p>
        <div style="margin-top:var(--sp-6)"><NewsletterSignup lang="en" source="newsletter-seite" /></div>

        {issues.length > 0 && (
          <section class="nlarchive" aria-labelledby="nlarchive-h">
            <h2 class="h3" id="nlarchive-h">Past issues</h2>
            <p class="caption" style="margin-top:var(--sp-2)">The newsletter is published in German.</p>
            <ol class="nlarchive__list">
              {issues.map((i) => (
                <li>
                  <a class="nlarchive__item" href={`/newsletter/ausgaben/${i.pdf}`} target="_blank" rel="noopener">
                    <span class="nlarchive__date">{when(i.date)}</span>
                    <span class="nlarchive__title">{i.title}</span>
                    {i.teaser && <span class="nlarchive__teaser">{i.teaser}</span>}
                    <span class="nlarchive__go">Open PDF&nbsp;<span aria-hidden="true">→</span></span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>

      <div class="nlview" data-view="confirm">
        <h1>Please confirm your sign-up.</h1>
        <p class="lead" style="margin-top:var(--sp-5)">With one click we add your address to our newsletter list.</p>
        <p style="margin-top:var(--sp-6)"><button type="button" class="btn btn--primary" data-nl-confirm>Confirm sign-up</button></p>
        <p class="nlview__status" data-nl-confirm-status aria-live="polite" data-sending="Confirming …" data-fail="Sorry, that did not work. Please try again or write to us at vorstand@fridosfriends.de."></p>
      </div>

      <div class="nlview" data-view="done" tabindex="-1">
        <h1>Thank you.</h1>
        <p class="lead" style="margin-top:var(--sp-5)">Your sign-up is confirmed. From now on you will receive our newsletter.</p>
        <p style="margin-top:var(--sp-6)"><a class="btn btn--secondary" href="/en/">Back to home</a></p>
      </div>

      <div class="nlview" data-view="error" tabindex="-1">
        <h1>This link is no longer valid.</h1>
        <p class="lead" style="margin-top:var(--sp-5)">Please sign up again — we will send you a new link.</p>
        <div style="margin-top:var(--sp-6)"><NewsletterSignup lang="en" source="newsletter-neu" /></div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nlview { display:none; }
  [data-nlview="signup"] [data-view="signup"], [data-nlview="confirm"] [data-view="confirm"],
  [data-nlview="done"] [data-view="done"], [data-nlview="error"] [data-view="error"] { display:block; }
  .nlview:focus { outline:none; }
  .nlarchive { margin-top:var(--sp-8); padding-top:var(--sp-6); border-top:1px solid var(--line); }
  .nlarchive__list { list-style:none; padding:0; margin:var(--sp-5) 0 0; display:grid; gap:var(--sp-3); }
  .nlarchive__item { display:grid; gap:var(--sp-1); padding:var(--sp-5); text-decoration:none; color:inherit;
    background:var(--paper-pure, #fff); border:1px solid var(--line-strong, #D6CDB6); border-radius:var(--r-card);
    transition:transform 180ms var(--ease-out), box-shadow 180ms var(--ease-out), border-color 180ms var(--ease-out); }
  .nlarchive__item:hover, .nlarchive__item:focus-visible { transform:translateY(-2px); box-shadow:var(--shadow-lift); border-color:var(--gold); }
  .nlarchive__item:focus-visible { outline:2px solid var(--teal); outline-offset:3px; }
  .nlarchive__date { font-family:var(--font-sans); font-size:var(--step--1); font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--gold-text); }
  .nlarchive__title { font-family:var(--font-serif); font-weight:600; font-size:var(--step-2); line-height:1.2; color:var(--ink); }
  .nlarchive__teaser { color:var(--stone); font-size:var(--step-0); line-height:1.5; }
  .nlarchive__go { margin-top:var(--sp-2); font-family:var(--font-sans); font-weight:600; font-size:var(--step--1); color:var(--gold-text); }
  @media (prefers-reduced-motion: reduce) { .nlarchive__item { transition:none; } .nlarchive__item:hover { transform:none; } }
  .nlview__status { margin-top:var(--sp-4); color:var(--stone); min-height:1.4em; }
</style>

<script>
  const shell = document.querySelector('[data-nlpage]') as HTMLElement | null;
  const btn = document.querySelector('[data-nl-confirm]') as HTMLButtonElement | null;
  const status = document.querySelector('[data-nl-confirm-status]') as HTMLElement | null;
  const show = (v: string) => { if (!shell) return; shell.dataset.nlview = v; (shell.querySelector(`[data-view="${v}"]`) as HTMLElement | null)?.focus(); };
  btn?.addEventListener('click', async () => {
    const token = new URLSearchParams(location.search).get('t') || '';
    btn.disabled = true; if (status) status.textContent = status.dataset.sending || '';
    try {
      const res = await fetch('/.netlify/functions/newsletter', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'confirm', token }) });
      const j: any = await res.json().catch(() => ({}));
      if (res.ok && j.ok) { history.replaceState({}, '', location.pathname); show('done'); return; }
      if (res.status === 400 || res.status === 410) { history.replaceState({}, '', location.pathname); show('error'); return; }
      if (status) status.textContent = status.dataset.fail || '';
    } catch { if (status) status.textContent = status.dataset.fail || ''; }
    btn.disabled = false;
  });
</script>
