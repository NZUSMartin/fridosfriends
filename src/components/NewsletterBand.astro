---
/**
 * NewsletterBand.astro — a quiet section with the newsletter sign-up field.
 * Once the archive holds an issue (NEWSLETTER_ISSUES in consts.ts) a link to it appears on its own.
 * Props: lang 'de' | 'en' · source (where the sign-up happened, shown to the Vorstand)
 */
import Eyebrow from './Eyebrow.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import { NEWSLETTER_ISSUES } from '../consts';

interface Props { lang?: 'de' | 'en'; source: string; }
const { lang = 'de', source } = Astro.props;
const isEn = lang === 'en';
const hasIssues = NEWSLETTER_ISSUES.length > 0;
---
<section class="band band-pure section">
  <div class="container container-text" data-reveal-group>
    <div data-reveal>
      <Eyebrow text="Newsletter" />
      <h2>{isEn ? 'Stay close.' : 'Bleiben Sie nah dran.'}</h2>
      <p class="lead" style="margin-top:var(--sp-4)">
        {isEn ? 'We report on how the girls we support are doing.' : 'Wir berichten, wie es den geförderten Mädchen geht.'}
      </p>
    </div>
    <div style="margin-top:var(--sp-5)" data-reveal>
      <NewsletterSignup lang={lang} source={source} />
    </div>
    {hasIssues && (
      <p style="margin-top:var(--sp-5)" data-reveal>
        <a class="link-tertiary" href={isEn ? '/en/newsletter' : '/newsletter'}>{isEn ? 'Read all issues →' : 'Alle Ausgaben lesen →'}</a>
      </p>
    )}
  </div>
</section>
